<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="700.0" minWidth="800.0" prefHeight="800.0" prefWidth="900.0" styleClass="root" stylesheets="@../../styles/kiosk.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.KioskController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="header-bg">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <Button onAction="#goBack" text="← Back" styleClass="btn-back" />
         <Region HBox.hgrow="ALWAYS" />
         <Button onAction="#showRules" text="Rules &amp; Regulations" styleClass="btn-secondary" />
      </HBox>
   </top>
   
   <center>
      <VBox spacing="30.0" alignment="TOP_CENTER">
         <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
         </padding>
         
         <Label styleClass="screen-title" text="Add-On Services" />
         
         <VBox spacing="20.0" alignment="TOP_CENTER" prefWidth="600.0" styleClass="card">
            <Label styleClass="subtitle" text="Select Add-On Services" />
            <Separator prefWidth="550.0" />
            
            <VBox spacing="15.0" alignment="TOP_LEFT">
               <padding>
                  <Insets top="10.0" right="30.0" bottom="10.0" left="30.0" />
               </padding>
               
               <!-- Wi-Fi -->
               <VBox spacing="5.0">
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <CheckBox fx:id="wifiCheckBox" onAction="#updateAddOnTotal" text="Wi-Fi" styleClass="check-box" />
                     <Label text="($10.00 per night)" styleClass="label-standard" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="wifiPriceLabel" text="\$0.00" styleClass="price-info" visible="false" />
                  </HBox>
                  <Label fx:id="wifiCalculationLabel" text="" styleClass="calculation-text" visible="false" wrapText="true" />
               </VBox>
               
               <!-- Breakfast -->
               <VBox spacing="5.0">
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <CheckBox fx:id="breakfastCheckBox" onAction="#updateAddOnTotal" text="Breakfast" styleClass="check-box" />
                     <Label text="($15.00 per night)" styleClass="label-standard" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="breakfastPriceLabel" text="\$0.00" styleClass="price-info" visible="false" />
                  </HBox>
                  <Label fx:id="breakfastCalculationLabel" text="" styleClass="calculation-text" visible="false" wrapText="true" />
               </VBox>
               
               <!-- Parking -->
               <VBox spacing="5.0">
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <CheckBox fx:id="parkingCheckBox" onAction="#updateAddOnTotal" text="Parking" styleClass="check-box" />
                     <Label text="($20.00 per reservation)" styleClass="label-standard" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="parkingPriceLabel" text="\$0.00" styleClass="price-info" visible="false" />
                  </HBox>
                  <Label fx:id="parkingCalculationLabel" text="One-time charge" styleClass="calculation-text" visible="false" wrapText="true" />
               </VBox>
               
               <!-- Spa -->
               <VBox spacing="5.0">
                  <HBox spacing="15.0" alignment="CENTER_LEFT">
                     <CheckBox fx:id="spaCheckBox" onAction="#updateAddOnTotal" text="Spa Access" styleClass="check-box" />
                     <Label text="($50.00 per reservation)" styleClass="label-standard" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="spaPriceLabel" text="\$0.00" styleClass="price-info" visible="false" />
                  </HBox>
                  <Label fx:id="spaCalculationLabel" text="One-time charge" styleClass="calculation-text" visible="false" wrapText="true" />
               </VBox>
            </VBox>
         </VBox>
         
         <VBox spacing="10.0" alignment="CENTER" styleClass="card">
            <Label styleClass="subtitle" text="Add-Ons Total:" />
            <Label fx:id="addOnTotalLabel" styleClass="price-label" text="\$0.00" />
         </VBox>
         
         <HBox spacing="20.0" alignment="CENTER">
            <Button onAction="#goBack" prefWidth="100.0" text="Back" styleClass="btn-secondary" />
            <Button fx:id="nextButtonAddOns" onAction="#proceedToSummary" prefWidth="100.0" text="Next" styleClass="btn-primary" />
         </HBox>
      </VBox>
   </center>
</BorderPane>
