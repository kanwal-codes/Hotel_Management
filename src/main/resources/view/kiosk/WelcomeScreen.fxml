<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="700.0" minWidth="800.0" prefHeight="800.0" prefWidth="900.0" styleClass="root" stylesheets="@../../styles/kiosk.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.KioskController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="header-bg">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Button onAction="#goBackFromWelcome" text="← Back" styleClass="btn-back" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#showRules" text="Rules &amp; Regulations" styleClass="btn-secondary" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" styleClass="scroll-pane">
            <VBox alignment="TOP_CENTER" spacing="30.0">
                <padding>
                    <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
                </padding>

                <!-- Welcome Title Section -->
                <VBox spacing="10.0" alignment="CENTER">
                    <Label styleClass="welcome-title" text="Welcome to Hotel Reservation System" />
                    <Label styleClass="welcome-subtitle" text="We're delighted to have you here!" />
                </VBox>

                <!-- Optional Instructional Video/GIF Section -->
                <VBox fx:id="instructionalMediaContainer" spacing="10.0" alignment="CENTER" prefWidth="600.0" visible="false" managed="false" styleClass="card">
                    <Label styleClass="subtitle" text="How to Use This Kiosk" />
                    <Separator prefWidth="550.0" />
                    <!-- MediaView for video (optional - uncomment and set source if video file exists) -->
                    <!--
                    <MediaView fx:id="instructionalVideo" fitWidth="500.0" fitHeight="300.0" preserveRatio="true">
                        <mediaPlayer>
                            <Media fx:id="instructionalMedia" source="@../../media/instructional_video.mp4" />
                        </mediaPlayer>
                    </MediaView>
                    -->
                    <!-- ImageView for GIF (alternative to video) -->
                    <ImageView fx:id="instructionalGif" fitWidth="500.0" fitHeight="300.0" preserveRatio="true" />
                    <Label styleClass="body-text" text="Watch this short guide to learn how to make a reservation" wrapText="true" style="-fx-text-alignment: center;" />
                </VBox>

                <!-- Instructions Card -->
                <VBox spacing="15.0" alignment="TOP_CENTER" prefWidth="600.0" styleClass="card">
                    <Label styleClass="subtitle" text="How It Works" />
                    <Separator prefWidth="550.0" />
                    <VBox spacing="12.0" alignment="TOP_LEFT">
                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                            <Label styleClass="label-bold" text="1." prefWidth="30.0" />
                            <Label styleClass="body-text" text="Enter your booking details (dates and number of guests)" wrapText="true" />
                        </HBox>
                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                            <Label styleClass="label-bold" text="2." prefWidth="30.0" />
                            <Label styleClass="body-text" text="Select your preferred rooms from our available options" wrapText="true" />
                        </HBox>
                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                            <Label styleClass="label-bold" text="3." prefWidth="30.0" />
                            <Label styleClass="body-text" text="Provide your contact information" wrapText="true" />
                        </HBox>
                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                            <Label styleClass="label-bold" text="4." prefWidth="30.0" />
                            <Label styleClass="body-text" text="Choose any add-on services you'd like" wrapText="true" />
                        </HBox>
                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                            <Label styleClass="label-bold" text="5." prefWidth="30.0" />
                            <Label styleClass="body-text" text="Review your booking summary and confirm" wrapText="true" />
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Features Card -->
                <HBox spacing="20.0" alignment="CENTER" prefWidth="600.0">
                    <VBox spacing="10.0" alignment="CENTER" prefWidth="180.0" styleClass="card">
                        <Label styleClass="label-bold" text="✓ Easy Booking" />
                        <Label styleClass="body-text" text="Quick and simple reservation process" wrapText="true" style="-fx-text-alignment: center;" />
                    </VBox>
                    <VBox spacing="10.0" alignment="CENTER" prefWidth="180.0" styleClass="card">
                        <Label styleClass="label-bold" text="✓ Best Rates" />
                        <Label styleClass="body-text" text="Competitive pricing with transparent costs" wrapText="true" style="-fx-text-alignment: center;" />
                    </VBox>
                    <VBox spacing="10.0" alignment="CENTER" prefWidth="180.0" styleClass="card">
                        <Label styleClass="label-bold" text="✓ Instant Confirmation" />
                        <Label styleClass="body-text" text="Get your reservation number immediately" wrapText="true" style="-fx-text-alignment: center;" />
                    </VBox>
                </HBox>

                <!-- Important Information Card -->
                <VBox spacing="12.0" alignment="TOP_CENTER" prefWidth="600.0" styleClass="card">
                    <Label styleClass="subtitle" text="Important Information" />
                    <Separator prefWidth="550.0" />
                    <VBox spacing="8.0" alignment="TOP_LEFT">
                        <Label styleClass="body-text" text="• Billing will be handled at the front desk upon checkout" wrapText="true" />
                        <Label styleClass="body-text" text="• Please review our Rules and Regulations before proceeding" wrapText="true" />
                        <Label styleClass="body-text" text="• For assistance, please contact our front desk staff" wrapText="true" />
                    </VBox>
                </VBox>

                <!-- Navigation Buttons -->
                <VBox spacing="10.0" alignment="CENTER">
                    <Button onAction="#startBooking" prefHeight="50.0" prefWidth="250.0" text="Start Booking" styleClass="start-button" />
                    <Label styleClass="welcome-subtitle" text="Click the button above to begin your reservation" />
                </VBox>
                
                <HBox alignment="CENTER" spacing="20.0">
                    <Button onAction="#goBackFromWelcome" prefWidth="100.0" styleClass="btn-secondary" text="Back" />
                    <Button onAction="#startBooking" prefWidth="100.0" styleClass="btn-primary" text="Next" />
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
