<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="700.0" minWidth="800.0" prefHeight="800.0" prefWidth="900.0" styleClass="root" stylesheets="@../../styles/kiosk.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.KioskController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="header-bg">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <Button onAction="#goBack" text="← Back" styleClass="btn-back" />
         <Region HBox.hgrow="ALWAYS" />
         <Button onAction="#showRules" text="Rules &amp; Regulations" styleClass="btn-secondary" />
      </HBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" styleClass="scroll-pane">
         <VBox spacing="30.0" alignment="TOP_CENTER">
            <padding>
               <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
            </padding>
            
            <Label styleClass="screen-title" text="Booking Summary" />
            
            <!-- Guest Details -->
            <VBox spacing="10.0" alignment="TOP_CENTER" prefWidth="600.0" styleClass="card">
               <Label styleClass="subtitle" text="Guest Information:" />
               <Separator prefWidth="550.0" />
               <VBox spacing="8.0" alignment="TOP_LEFT">
                  <HBox spacing="10.0">
                     <Label text="Name:" styleClass="label-bold" prefWidth="120.0" />
                     <Label fx:id="guestNameLabel" styleClass="body-text" />
                  </HBox>
                  <HBox spacing="10.0">
                     <Label text="Phone:" styleClass="label-bold" prefWidth="120.0" />
                     <Label fx:id="guestPhoneLabel" styleClass="body-text" />
                  </HBox>
                  <HBox spacing="10.0">
                     <Label text="Email:" styleClass="label-bold" prefWidth="120.0" />
                     <Label fx:id="guestEmailLabel" styleClass="body-text" />
                  </HBox>
               </VBox>
            </VBox>
            
            <!-- Reservation Details -->
            <VBox spacing="10.0" alignment="TOP_CENTER" prefWidth="600.0" styleClass="card">
               <Label styleClass="subtitle" text="Reservation Details:" />
               <Separator prefWidth="550.0" />
               <VBox spacing="8.0" alignment="TOP_LEFT">
                  <HBox spacing="10.0">
                     <Label text="Check-in:" styleClass="label-bold" prefWidth="120.0" />
                     <Label fx:id="checkInLabel" styleClass="body-text" />
                  </HBox>
                  <HBox spacing="10.0">
                     <Label text="Check-out:" styleClass="label-bold" prefWidth="120.0" />
                     <Label fx:id="checkOutLabel" styleClass="body-text" />
                  </HBox>
                  <HBox spacing="10.0">
                     <Label text="Nights:" styleClass="label-bold" prefWidth="120.0" />
                     <Label fx:id="numNightsLabel" styleClass="body-text" />
                  </HBox>
                  <HBox spacing="10.0">
                     <Label text="Occupancy:" styleClass="label-bold" prefWidth="120.0" />
                     <Label fx:id="occupancyLabel" styleClass="body-text" />
                  </HBox>
                  <HBox spacing="10.0">
                     <Label text="Assigned Rooms:" styleClass="label-bold" prefWidth="120.0" />
                     <Label fx:id="assignedRoomsLabel" styleClass="body-text" wrapText="true" />
                  </HBox>
               </VBox>
               
               <!-- Add-On Breakdown -->
               <VBox fx:id="addonBreakdownContainer" spacing="10.0" alignment="TOP_LEFT" visible="false" managed="false">
                  <Separator prefWidth="550.0" />
                  <Label styleClass="label-bold" text="Selected Add-Ons:" />
                  <VBox fx:id="addonBreakdownList" spacing="5.0" />
               </VBox>
            </VBox>
            
            <!-- Price Breakdown -->
            <VBox spacing="10.0" alignment="TOP_CENTER" prefWidth="600.0" styleClass="card">
               <Label styleClass="subtitle" text="Price Breakdown:" />
               <Separator prefWidth="550.0" />
               <GridPane hgap="20.0" vgap="10.0">
                  <columnConstraints>
                     <ColumnConstraints hgrow="NEVER" minWidth="200.0" />
                     <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                  </columnConstraints>
                  <rowConstraints>
                     <RowConstraints minHeight="25.0" prefHeight="25.0" />
                     <RowConstraints minHeight="25.0" prefHeight="25.0" />
                     <RowConstraints minHeight="25.0" prefHeight="25.0" />
                     <RowConstraints minHeight="25.0" prefHeight="25.0" />
                     <RowConstraints minHeight="25.0" prefHeight="25.0" />
                     <RowConstraints minHeight="25.0" prefHeight="25.0" />
                     <RowConstraints minHeight="25.0" prefHeight="25.0" />
                  </rowConstraints>
                  
                  <children>
                     <Label text="Room Subtotal:" styleClass="label-standard" GridPane.rowIndex="0" />
                     <Label fx:id="roomSubtotalLabel" alignment="CENTER_RIGHT" styleClass="body-text" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                     
                     <Label text="Add-Ons Subtotal:" styleClass="label-standard" GridPane.rowIndex="1" />
                     <Label fx:id="addOnSubtotalLabel" alignment="CENTER_RIGHT" styleClass="body-text" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     
                     <Label text="Tax Rate:" styleClass="label-standard" GridPane.rowIndex="2" />
                     <Label fx:id="taxRateLabel" alignment="CENTER_RIGHT" styleClass="body-text" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     
                     <Label text="Tax Amount:" styleClass="label-standard" GridPane.rowIndex="3" />
                     <Label fx:id="taxAmountLabel" alignment="CENTER_RIGHT" styleClass="body-text" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                     
                     <VBox fx:id="discountContainer" visible="false" managed="false" GridPane.columnSpan="2" GridPane.rowIndex="4">
                        <HBox spacing="20.0">
                           <Label text="Discount:" styleClass="label-standard" />
                           <Label fx:id="discountLabel" alignment="CENTER_RIGHT" styleClass="body-text" />
                        </HBox>
                     </VBox>
                     
                     <VBox fx:id="loyaltyContainer" visible="false" managed="false" GridPane.columnSpan="2" GridPane.rowIndex="5">
                        <HBox spacing="20.0">
                           <Label text="Loyalty Points Effect:" styleClass="label-standard" />
                           <Label fx:id="loyaltyLabel" alignment="CENTER_RIGHT" styleClass="body-text" />
                        </HBox>
                     </VBox>
                     
                     <Separator GridPane.columnSpan="2" GridPane.rowIndex="6" />
                     
                     <Label styleClass="total-label" text="Total Amount:" GridPane.rowIndex="7" />
                     <Label fx:id="totalAmountLabel" alignment="CENTER_RIGHT" styleClass="total-label" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                  </children>
               </GridPane>
            </VBox>
            
            <HBox spacing="20.0" alignment="CENTER">
               <Button onAction="#goBack" prefWidth="100.0" text="Back" styleClass="btn-secondary" />
               <Button onAction="#payNow" prefHeight="40.0" prefWidth="150.0" text="Pay Now" styleClass="btn-primary" />
            </HBox>
         </VBox>
      </ScrollPane>
   </center>
   
</BorderPane>

