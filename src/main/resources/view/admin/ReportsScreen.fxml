<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="700.0" minWidth="800.0" prefHeight="800.0" prefWidth="900.0" styleClass="root" stylesheets="@../../styles/admin.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.ReportController">
   <top>
      <HBox spacing="20.0" alignment="CENTER_LEFT" styleClass="header-bg">
         <Button onAction="#goBack" text="← Back" styleClass="btn-back" />
         <Label styleClass="page-title" text="Reports" />
      </HBox>
   </top>
   
   <left>
      <VBox spacing="12.0" styleClass="sidebar-bg">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <Label text="Report Types" styleClass="subsection-title" />
         <Separator />
         <Button onAction="#showRevenueReports" prefWidth="200.0" text="Revenue Reports" styleClass="nav-button" />
         <Button onAction="#showOccupancyReports" prefWidth="200.0" text="Occupancy Reports" styleClass="nav-button" />
         <Button onAction="#showActivityLogs" prefWidth="200.0" text="Activity Logs" styleClass="nav-button" />
         <Button onAction="#showFeedbackSummary" prefWidth="200.0" text="Feedback Summary" styleClass="nav-button" />
      </VBox>
   </left>
   
   <center>
      <ScrollPane fitToWidth="true" styleClass="scroll-pane">
         <VBox spacing="20.0">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
         
         <!-- Report Type Selection -->
         <VBox spacing="15.0" styleClass="card">
            <Label styleClass="section-title" text="Report Parameters" />
            <Separator />
            <GridPane hgap="15.0" vgap="12.0">
               <columnConstraints>
                  <ColumnConstraints halignment="RIGHT" minWidth="120.0" />
                  <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="35.0" />
                  <RowConstraints minHeight="35.0" />
                  <RowConstraints minHeight="35.0" />
               </rowConstraints>
               <children>
                  <Label text="Report Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-bold" />
                  <ComboBox fx:id="reportTypeComboBox" onAction="#generateReport" prefWidth="200.0" styleClass="combo-box" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                  
                  <Label text="Date Range:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-bold" />
                  <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
                     <DatePicker fx:id="startDatePicker" promptText="Start Date" styleClass="date-picker" />
                     <Label text="to" styleClass="body-text" />
                     <DatePicker fx:id="endDatePicker" promptText="End Date" styleClass="date-picker" />
                  </HBox>
                  
                  <Label text="Room Type:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-bold" />
                  <ComboBox fx:id="roomTypeComboBox" onAction="#generateReport" prefWidth="150.0" styleClass="combo-box" GridPane.rowIndex="2" GridPane.columnIndex="1" />
               </children>
            </GridPane>
            <HBox spacing="15.0" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
               <Button onAction="#generateReport" text="Generate Report" styleClass="btn-success btn-large" />
            </HBox>
         </VBox>
         
         <!-- Report Display -->
         <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <Label styleClass="section-title" text="Report Results" />
            <TableView fx:id="reportTable" prefHeight="400.0" VBox.vgrow="ALWAYS" styleClass="table-view">
               <!-- Columns will be dynamically set based on report type -->
            </TableView>
         </VBox>
         
         <!-- Export Buttons -->
         <HBox spacing="15.0" alignment="CENTER" styleClass="pagination-container">
            <Button onAction="#exportToCSV" text="Export to CSV" styleClass="btn-success" />
            <Button onAction="#exportToPDF" text="Export to PDF" styleClass="btn-danger" />
            <Button fx:id="txtExportButton" onAction="#exportToTXT" text="Export to TXT" visible="false" styleClass="btn-secondary" />
         </HBox>
      </VBox>
      </ScrollPane>
   </center>
   
</BorderPane>
