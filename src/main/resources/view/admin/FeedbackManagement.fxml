<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="700.0" minWidth="800.0" prefHeight="800.0" prefWidth="900.0" styleClass="root" stylesheets="@../../styles/admin.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.AdminFeedbackController">
   <top>
      <HBox spacing="20.0" alignment="CENTER_LEFT" styleClass="header-bg">
         <Button onAction="#goBack" text="← Back" styleClass="btn-back" />
         <Label styleClass="page-title" text="Feedback Management" />
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" styleClass="scroll-pane">
         <VBox spacing="20.0">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

         <!-- Filters -->
         <VBox spacing="12.0" styleClass="card">
            <Label styleClass="section-title" text="Filter Feedback" />
            <Separator />
            <GridPane hgap="15.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="NEVER" minWidth="70.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                  <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                  <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                  <ColumnConstraints hgrow="NEVER" minWidth="60.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
               </columnConstraints>
               <children>
                  <Label text="Rating:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <ComboBox fx:id="ratingFilterComboBox" onAction="#filterFeedback" prefWidth="150.0" promptText="All Ratings" styleClass="combo-box" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Date Range:" styleClass="label-bold" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <HBox spacing="10.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                     <DatePicker fx:id="feedbackStartDatePicker" promptText="Start Date" styleClass="date-picker" HBox.hgrow="ALWAYS" />
                     <DatePicker fx:id="feedbackEndDatePicker" promptText="End Date" styleClass="date-picker" HBox.hgrow="ALWAYS" />
                  </HBox>
                  <Label text="Sentiment:" styleClass="label-bold" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                  <ComboBox fx:id="sentimentFilterComboBox" onAction="#filterFeedback" prefWidth="150.0" promptText="All Tags" styleClass="combo-box" GridPane.columnIndex="5" GridPane.rowIndex="0" />
                  <Label text="Guest:" styleClass="label-bold" GridPane.columnIndex="6" GridPane.rowIndex="0" />
                  <TextField fx:id="guestFilterField" onKeyReleased="#filterFeedback" prefWidth="150.0" promptText="Search guest" styleClass="text-field" GridPane.columnIndex="7" GridPane.rowIndex="0" />
               </children>
            </GridPane>
            <HBox spacing="12.0" alignment="CENTER_LEFT">
               <Button onAction="#filterFeedback" text="Apply Filters" styleClass="btn-success" />
               <Button onAction="#clearFeedbackFilters" text="Clear Filters" styleClass="btn-secondary" />
            </HBox>
         </VBox>

         <!-- Statistics -->
         <HBox spacing="30.0" alignment="CENTER" styleClass="stat-card">
            <VBox spacing="8.0" alignment="CENTER">
               <Label styleClass="stat-label" text="Average Rating" />
               <Label fx:id="averageRatingLabel" styleClass="stat-value" />
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="60.0" />
            <VBox spacing="8.0" alignment="CENTER">
               <Label styleClass="stat-label" text="Total Feedback" />
               <Label fx:id="totalFeedbackLabel" styleClass="stat-value" />
            </VBox>
         </HBox>

         <!-- Common Issue Tags -->
         <VBox spacing="10.0" styleClass="card">
            <Label styleClass="subsection-title" text="Common Issue Tags" />
            <Label fx:id="issueTagsLabel" styleClass="body-text" wrapText="true" />
         </VBox>

         <!-- Feedback Table -->
         <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <Label styleClass="section-title" text="Feedback Entries" />
            <TableView fx:id="feedbackTable" prefHeight="300.0" VBox.vgrow="ALWAYS" styleClass="table-view">
               <columns>
                  <TableColumn fx:id="reservationIdColumn" minWidth="120.0" text="Reservation ID" />
                  <TableColumn fx:id="guestNameColumn" minWidth="150.0" text="Guest Name" />
                  <TableColumn fx:id="ratingColumn" minWidth="80.0" text="Rating" />
                  <TableColumn fx:id="commentColumn" minWidth="300.0" text="Comment" />
                  <TableColumn fx:id="dateColumn" minWidth="120.0" text="Date" />
                  <TableColumn fx:id="sentimentColumn" minWidth="120.0" text="Sentiment Tag" />
               </columns>
            </TableView>
         </VBox>

         <!-- Export Button -->
         <HBox alignment="CENTER" styleClass="pagination-container">
            <Button onAction="#exportFeedbackToCSV" prefWidth="200.0" text="Export to CSV" styleClass="btn-primary" />
         </HBox>
      </VBox>
      </ScrollPane>
   </center>

</BorderPane>
