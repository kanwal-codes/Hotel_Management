<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="700.0" minWidth="800.0" prefHeight="800.0" prefWidth="900.0" styleClass="root" stylesheets="@../../styles/feedback.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.FeedbackController">
   <center>
      <VBox alignment="CENTER" spacing="30.0">
         <padding>
            <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
         </padding>
         
         <!-- Success Title -->
         <Label styleClass="success-title" text="✓ Thank You!" />
         
         <!-- Confirmation Message -->
         <VBox alignment="CENTER" spacing="15.0" styleClass="card">
            <Label styleClass="subtitle" text="Your feedback has been submitted successfully." />
            <Label styleClass="subtitle" text="We appreciate your time and value your opinion." />
         </VBox>
         
         <!-- Action Buttons -->
         <HBox alignment="CENTER">
            <Button fx:id="anotherButton" onAction="#submitAnother" prefWidth="150.0" styleClass="btn-secondary" text="Submit Another" visible="false" />
            <Button alignment="CENTER" onAction="#done" prefHeight="38.0" prefWidth="96.0" styleClass="btn-primary" text="Done" />
            <padding>
               <Insets right="150.0" />
            </padding>
         </HBox>
      </VBox>
   </center>
   
</BorderPane>
