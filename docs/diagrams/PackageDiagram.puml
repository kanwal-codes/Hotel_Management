@startuml Package Diagram - Hotel Reservation System

!theme plain
skinparam packageStyle rectangle
skinparam packagePadding 2
skinparam defaultFontSize 7
skinparam maxMessageSize 40
skinparam wrapWidth 80

' Group packages to create 2-column layout
package "com.hotel" {
    
    ' Left Column - Core Layers
    package "app" {
        [Main]
        [AppConfig]
    }
    
    package "config" {
        [PricingPolicy]
        [DiscountPolicy]
        [LoyaltyPolicy]
    }
    
    package "model" {
        [Reservation]
        [Guest]
        [Room]
        [Billing]
        [Payment]
        [ServiceAddon]
        [Waitlist]
        [Feedback]
        [AdminUser]
    }
    
    package "repository" {
        [ReservationRepository]
        [GuestRepository]
        [RoomRepository]
        [BillingRepository]
        [PaymentRepository]
        [WaitlistRepository]
        [FeedbackRepository]
    }
    
    ' Right Column - Business Logic & UI
    package "service" {
        [ReservationService]
        [BillingService]
        [LoyaltyService]
        [WaitlistService]
        [ReportingService]
        [FeedbackService]
        [AuthService]
        
        package "strategy" {
            [BillingStrategy]
            [StandardBillingStrategy]
            [DiscountBillingStrategy]
            [LoyaltyBillingStrategy]
        }
        
        package "decorator" {
            [BookingComponent]
            [RoomBookingComponent]
            [AddOnDecorator]
        }
    }
    
    package "events" {
        [Subject]
        [Observer]
        [RoomAvailabilityPublisher]
        [WaitlistSubscriber]
    }
    
    package "controller" {
        [KioskController]
        [AdminDashboardController]
        [AdminReservationController]
        [AdminPaymentController]
        [ReportController]
        [UnifiedLoginController]
        
        package "helper" {
            [KioskLoyaltyHelper]
            [KioskRoomSelectionHelper]
            [KioskGuestDetailsHelper]
            [KioskBookingSummaryHelper]
        }
    }
    
    package "util" {
        [LoggerService]
        [RoomFactory]
        [PdfExporter]
        [CsvExporter]
    }
    
    package "security" {
        [BCryptPasswordHasher]
    }
}

' Key Dependencies - Simplified
[Main] --> [AppConfig]
[AppConfig] --> [PricingPolicy]
[AppConfig] --> [DiscountPolicy]

[KioskController] --> [ReservationService]
[KioskController] --> [BillingService]
[AdminDashboardController] --> [ReservationService]
[AdminDashboardController] --> [ReportingService]
[AdminPaymentController] --> [BillingService]
[ReportController] --> [ReportingService]
[UnifiedLoginController] --> [AuthService]

[ReservationService] --> [ReservationRepository]
[ReservationService] --> [RoomRepository]
[BillingService] --> [BillingRepository]
[BillingService] --> [BillingStrategy]
[LoyaltyService] --> [GuestRepository]

[ReservationRepository] --> [Reservation]
[GuestRepository] --> [Guest]
[RoomRepository] --> [Room]
[BillingRepository] --> [Billing]

[ReservationService] --> [RoomAvailabilityPublisher]
[RoomAvailabilityPublisher] --> [Observer]

[BillingStrategy] <|-- [StandardBillingStrategy]
[BillingStrategy] <|-- [DiscountBillingStrategy]
[BillingStrategy] <|-- [LoyaltyBillingStrategy]

[BookingComponent] <|-- [RoomBookingComponent]
[BookingComponent] <|-- [AddOnDecorator]

@enduml
