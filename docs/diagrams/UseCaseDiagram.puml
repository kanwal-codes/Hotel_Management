@startuml Use Case Diagram

!theme plain

left to right direction

actor Guest
actor Admin
actor Manager

rectangle "Hotel Reservation System" {
    ' Guest Use Cases
    usecase "Book Room" as UC1
    usecase "Select Room Combinations\n(for groups >4)" as UC1A
    usecase "Enroll in Loyalty Program\n(with confirmation)" as UC1B
    usecase "Select Add-ons" as UC2
    usecase "Pay Deposit at Booking" as UC3A
    usecase "Process Payment" as UC3
    usecase "View Booking" as UC4
    usecase "Submit Feedback\n(after checkout)" as UC5
    usecase "Lookup Loyalty Number" as UC1C
    
    ' Admin Use Cases
    usecase "Manage Reservations" as UC6
    usecase "Process Check-in" as UC6A
    usecase "Process Checkout" as UC7
    usecase "Process Partial Payment\n(during stay)" as UC7A
    usecase "Apply Discount" as UC8
    usecase "Manage Waitlist" as UC9
    usecase "Convert Waitlist to Reservation" as UC9A
    usecase "View Reports" as UC10
    usecase "View Activity Logs\n(from database or file)" as UC10A
    usecase "Manage Loyalty" as UC11
    usecase "View Feedback" as UC12
    usecase "Generate Revenue Report" as UC10B
    usecase "Generate Occupancy Report" as UC10C
}

' Guest relationships
Guest --> UC1
Guest --> UC1A : "For groups >4 adults"
Guest --> UC1B : "Optional enrollment\nwith confirmation"
Guest --> UC1C
Guest --> UC2
Guest --> UC3A : "Optional deposit"
Guest --> UC3
Guest --> UC4
Guest --> UC5 : "Only after checkout"

' Admin relationships
Admin --> UC6
Admin --> UC6A
Admin --> UC7
Admin --> UC7A : "During guest stay"
Admin --> UC8 : "Up to 15%"
Admin --> UC9
Admin --> UC9A : "Quick conversion"
Admin --> UC10
Admin --> UC10A : "From DB or log file"
Admin --> UC10B
Admin --> UC10C
Admin --> UC11
Admin --> UC12

' Manager relationships
Manager --> UC6
Manager --> UC6A
Manager --> UC7
Manager --> UC7A
Manager --> UC8 : "Up to 30%"
Manager --> UC9
Manager --> UC9A
Manager --> UC10
Manager --> UC10A
Manager --> UC10B
Manager --> UC10C
Manager --> UC11
Manager --> UC12

' Use case relationships
UC1 ..> UC1A : extends
UC1 ..> UC1B : extends
UC1 ..> UC2 : includes
UC1 ..> UC3A : extends
UC1 ..> UC3 : includes
UC7 ..> UC7A : extends
UC9 ..> UC9A : extends
UC10 ..> UC10A : includes
UC10 ..> UC10B : includes
UC10 ..> UC10C : includes
UC5 ..> UC12 : extends

@enduml
