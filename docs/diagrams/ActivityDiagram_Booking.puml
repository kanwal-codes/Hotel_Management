@startuml Activity Diagram - Booking Flow

!theme plain

start

:Guest arrives at kiosk;
:Display welcome screen;

:Guest selects dates;
:Guest enters guest details\n(name, email, phone);
:Validate guest information;

if (Guest exists in system?) then (yes)
    :Load existing guest;
    if (Guest has loyalty number?) then (yes)
        :Display loyalty points;
    else (no)
    endif
else (no)
    :Create new guest;
endif

:Guest optionally enrolls in loyalty;
if (Guest wants to enroll?) then (yes)
    :Show confirmation dialog\nwith guest information;
    if (Guest confirms?) then (yes)
        :Issue loyalty number;
        :Display loyalty number;
    else (no)
        :Skip enrollment;
    endif
else (no)
endif

:Guest enters number of adults and children;
:Calculate total people;

:Request room suggestions;
if (Total people > 4?) then (yes)
    :Generate combination suggestions\n(double + single rooms);
    :Display combination options;
else if (Total people 3-4?) then (yes)
    :Suggest 1 double OR 2 singles;
else (1-2 people)
    :Suggest 1 single room;
endif

:Display room suggestions in table;
if (Guest selects suggestion?) then (yes)
    if (Suggestion is combination?) then (yes)
        :Select primary room type;
        :Select secondary room type;
        :Combine rooms;
    else (single type)
        :Select rooms of one type;
    endif
else (custom selection)
    :Guest manually selects rooms;
    :Validate occupancy rules;
    if (Occupancy valid?) then (no)
        :Show error message;
        :Return to room selection;
    else (yes)
    endif
endif

:Check room availability;
if (Rooms available?) then (no)
    :Show error message;
    stop
else (yes)
endif

:Guest selects add-ons\n(WiFi, Breakfast, etc.);
:Calculate add-on prices;
:Display price impact for each add-on;

:Calculate subtotal;
:Calculate tax;
:Apply loyalty discount if applicable;
:Display booking summary\nwith loyalty effects;

if (Guest confirms booking?) then (no)
    :Return to room selection;
else (yes)
endif

:Create reservation;
:Create ReservationRoom entities;
:Create ReservationAddon entities;
:Create billing record;
:Calculate total amount;

if (Guest pays deposit?) then (yes)
    :Process deposit payment;
    :Update billing paidAmount;
else (no)
    :Set payment status to PENDING;
endif

:Update room status to OCCUPIED;
:Generate confirmation number;
:Display confirmation screen\nwith billing message;

stop

@enduml
