@startuml Hotel Reservation System - Class Diagram

!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam maxMessageSize 50
skinparam wrapWidth 70
skinparam packageStyle rectangle
skinparam packageBackgroundColor<<model>> #E1F5FE
skinparam packageBackgroundColor<<service>> #FFF3E0
skinparam packageBackgroundColor<<repository>> #FFF9C4
skinparam packageBackgroundColor<<controller>> #FFEBEE
skinparam packageBackgroundColor<<helper>> #E0F2F1
skinparam packageBackgroundColor<<util>> #FCE4EC
skinparam defaultFontSize 7
skinparam classFontSize 6
skinparam packagePadding 1
skinparam classPadding 1
skinparam maxClassWidth 70
skinparam minClassWidth 50
skinparam roundcorner 5

' ============================================
' MODEL LAYER
' ============================================
package "com.hotel.model" <<model>> {
    class Reservation {
        -Long id
        -LocalDate checkIn
        -LocalDate checkOut
        -ReservationStatus status
        +Guest guest
        +Billing billing
    }
    
    class Guest {
        -Long id
        -String name
        -String email
        -int loyaltyPoints
        -String loyaltyNumber
    }
    
    class Room {
        -Long id
        -int roomNumber
        -RoomType type
        -double basePrice
        -RoomStatus status
    }
    
    class Billing {
        -Long id
        -double subtotal
        -double totalAmount
        -double balanceAmount
        +Reservation reservation
        +List<Payment> payments
    }
    
    class Payment {
        -Long id
        -PaymentMethod method
        -double amount
    }
    
    class ServiceAddon {
        -Long id
        -String name
        -double price
    }
    
    class Waitlist {
        -Long id
        -LocalDate preferredCheckIn
        -RoomType preferredRoomType
    }
    
    class Feedback {
        -Long id
        -int rating
        -String comments
    }
    
    class AdminUser {
        -Long id
        -String username
        -Role role
    }
    
    class AuditLog {
        -Long id
        -LocalDateTime timestamp
        -String actor
        -String action
    }
    
    enum RoomType {
        SINGLE
        DOUBLE
        DELUXE
        PENTHOUSE
    }
    
    enum ReservationStatus {
        PENDING
        CONFIRMED
        CHECKED_IN
        CHECKED_OUT
        CANCELLED
    }
}

' ============================================
' SERVICE LAYER
' ============================================
package "com.hotel.service" <<service>> {
    class ReservationService {
        +suggestRooms(...) : List<RoomSuggestion>
        +createReservation(...) : Reservation
        +checkInReservation(reservationId)
        +checkoutReservation(reservationId)
        +cancelReservation(reservationId)
    }
    
    class RoomSuggestion {
        -Room room
        -int quantity
        -RoomType secondaryRoomType
        -int secondaryQuantity
        +isCombination() : boolean
    }
    
    class BillingService {
        +createBilling(...) : Billing
        +createDeposit(...) : Payment
        +processPartialPayment(...) : Payment
        +processPayment(...) : Payment
        +recalculateTotal(billing)
    }
    
    class LoyaltyService {
        +earnPoints(guest, amount) : int
        +redeemPoints(guest, points) : double
        +enrollGuest(guest) : String
    }
    
    class WaitlistService {
        +addToWaitlist(...) : Waitlist
        +notifyAvailableRoom(room)
    }
    
    class ReportingService {
        +generateRevenueReport(...) : RevenueReport
        +generateOccupancyReport(...) : OccupancyReport
        +getActivityLogs(...) : List<AuditLog>
        +getActivityLogsFromFile(...) : List<AuditLog>
    }
    
    class PricingService {
        +calculateRoomPrice(...) : double
    }
    
    class FeedbackService {
        +canSubmitFeedback(reservation) : boolean
        +submitFeedback(...) : Feedback
    }
    
    class AuthService {
        +login(username, password) : Optional<AdminUser>
    }
    
    class ActivityLogService {
        +logActivity(...)
    }
}

package "com.hotel.service.strategy" <<service>> {
    interface BillingStrategy {
        +calculateTotal(Billing) : double
    }
    
    class StandardBillingStrategy
    class DiscountBillingStrategy
    class LoyaltyBillingStrategy
}

package "com.hotel.service.decorator" <<service>> {
    abstract class BookingComponent {
        +getPrice() : double
    }
    
    class RoomBookingComponent
    class AddOnDecorator
    class CombinedBookingComponent
}

package "com.hotel.events" <<service>> {
    interface Subject {
        +subscribe(Observer)
        +notifyObservers(String)
    }
    
    interface Observer {
        +update(String)
    }
    
    class RoomAvailabilityPublisher
    class WaitlistSubscriber
}

' ============================================
' REPOSITORY LAYER
' ============================================
package "com.hotel.repository" <<repository>> {
    class ReservationRepository {
        +save(Reservation) : Reservation
        +findById(Long) : Optional<Reservation>
    }
    
    class GuestRepository {
        +save(Guest) : Guest
        +findByEmail(String) : Optional<Guest>
        +findByLoyaltyNumber(String) : Optional<Guest>
    }
    
    class RoomRepository {
        +findByType(RoomType) : List<Room>
        +findAvailableByTypeAndDateRange(...) : List<Room>
    }
    
    class BillingRepository {
        +save(Billing) : Billing
        +findByReservation(Reservation) : Optional<Billing>
    }
    
    class PaymentRepository {
        +save(Payment) : Payment
    }
    
    class AuditLogRepository {
        +findByDateRange(...) : List<AuditLog>
    }
    
    class WaitlistRepository {
        +save(Waitlist) : Waitlist
    }
    
    class FeedbackRepository {
        +save(Feedback) : Feedback
    }
}

' ============================================
' CONTROLLER LAYER
' ============================================
package "com.hotel.controller" <<controller>> {
    class KioskController {
        +validateGuestDetails()
        +processBooking()
        +enrollInLoyalty()
    }
    
    class AdminDashboardController {
        +loadDashboard()
        +searchReservations()
    }
    
    class AdminReservationController {
        +viewReservation()
        +cancelReservation()
    }
    
    class AdminPaymentController {
        +processPayment()
        +createDeposit()
        +processPartialPayment()
    }
    
    class ReportController {
        +generateRevenueReport()
        +generateActivityLogs()
    }
    
    class UnifiedLoginController {
        +handleLogin()
    }
}

' ============================================
' HELPER LAYER
' ============================================
package "com.hotel.controller.helper" <<helper>> {
    class KioskLoyaltyHelper {
        +{static} enrollInLoyalty(...)
        +{static} enrollInLoyaltyFromGuestDetails(...)
    }
    
    class KioskRoomSelectionHelper {
        +{static} processAcceptedSuggestion(...) : List<Room>
        +{static} validateCustomRoomSelection(...)
    }
    
    class KioskGuestDetailsHelper {
        +{static} enrollGuestInLoyalty(...) : String
    }
    
    class KioskBookingSummaryHelper {
        +{static} calculateAndDisplayLoyaltyEffects(...)
    }
    
    class KioskConfirmationHelper {
        +{static} updateLoyaltyEnrollmentUI(...)
    }
}

' ============================================
' UTILITY LAYER
' ============================================
package "com.hotel.util" <<util>> {
    class LoggerService {
        +{static} getInstance() : LoggerService
        +logActivity(...)
    }
    
    class CsvExporter {
        +exportReservations(...) : boolean
    }
    
    class PdfExporter {
        +exportReceipt(...) : boolean
    }
    
    class RoomFactory {
        +{static} createRoom(...) : Room
    }
}

' Core Model Relationships
Reservation "1" --> "*" ReservationRoom
Reservation "1" --> "1" Guest
Reservation "1" --> "1" Billing
Guest "1" --> "*" Reservation
Room "1" --> "*" ReservationRoom
Billing "1" --> "*" Payment
AdminUser "1" --> "*" AuditLog

' Service Relationships
ReservationService ..> RoomSuggestion : creates
ReservationService ..> ReservationRepository
ReservationService ..> RoomRepository
BillingService ..> BillingRepository
BillingService ..> BillingStrategy
BillingService ..> LoyaltyService
ReportingService ..> AuditLogRepository

' Strategy Pattern
BillingStrategy <|.. StandardBillingStrategy
BillingStrategy <|.. DiscountBillingStrategy
BillingStrategy <|.. LoyaltyBillingStrategy

' Decorator Pattern
BookingComponent <|-- RoomBookingComponent
BookingComponent <|-- AddOnDecorator
AddOnDecorator --> BookingComponent

' Observer Pattern
Subject <|.. RoomAvailabilityPublisher
Observer <|.. WaitlistSubscriber
RoomAvailabilityPublisher --> Observer

' Controller Relationships
KioskController ..> ReservationService
KioskController ..> BillingService
KioskController ..> KioskLoyaltyHelper
KioskController ..> KioskRoomSelectionHelper
AdminDashboardController ..> ReportingService
ReportController ..> ReportingService

@enduml
