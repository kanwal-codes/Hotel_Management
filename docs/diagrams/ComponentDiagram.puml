@startuml Component Diagram - System Architecture

!theme plain

package "Presentation Layer" {
    component "Kiosk UI" as KioskUI
    component "Admin UI" as AdminUI
    component "Feedback UI" as FeedbackUI
}

package "Application Layer" {
    component "Controllers" as Controllers {
        [KioskController]
        [AdminControllers]
    }
    
    component "Services" as Services {
        [ReservationService]
        [BillingService]
        [LoyaltyService]
        [WaitlistService]
        [ReportingService]
    }
    
    component "Policies" as Policies {
        [PricingPolicy]
        [DiscountPolicy]
        [LoyaltyPolicy]
    }
    
    component "Patterns" as Patterns {
        [Strategy Pattern]
        [Observer Pattern]
        [Decorator Pattern]
        [Factory Pattern]
    }
}

package "Data Layer" {
    component "Repositories" as Repos {
        [ReservationRepository]
        [GuestRepository]
        [RoomRepository]
        [BillingRepository]
    }
    
    component "JPA/Hibernate" as ORM
    
    database "MySQL Database" as DB
}

component "Cross-Cutting" {
    [LoggerService]
    [BCryptPasswordHasher]
    [Exporters]
}

KioskUI --> Controllers
AdminUI --> Controllers
FeedbackUI --> Controllers

Controllers --> Services
Services --> Policies
Services --> Patterns
Services --> Repos

Repos --> ORM
ORM --> DB

Services --> LoggerService
Services --> BCryptPasswordHasher
Services --> Exporters

@enduml





